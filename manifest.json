{
  "manifest_version": 2,
  "name": "Elsevier PDF Helper",
  "version": "0.2.5",
  "description": "Download legally accessible Elsevier/ScienceDirect PDFs and attach them to Zotero items.",
  "author": "Codex",
  "homepage_url": "https://github.com/ipconfig2023/zotero-elsevier-pdf-helper",
  "applications": {
    "zotero": {
      "id": "elsevier-pdf-helper@codex.local",
      "update_url": "https://example.invalid/elsevier-pdf-helper/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  },
  "icons": {
    "48": "icons/icon@48.png",
    "96": "icons/icon@96.png"
  }
}
